* text=auto

# Unity YAML assets should stay text and use Smart Merge.
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.mat text eol=lf merge=unityyamlmerge
*.anim text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.meta text eol=lf merge=unityyamlmerge

# Large binary source assets belong in Git LFS.
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text

# Approved AI binary art is shared through LFS. Sidecar JSON and Unity meta files stay diffable text.
ArtSource/AI/Approved/*.png filter=lfs diff=lfs merge=lfs -text
ArtSource/AI/Approved/*.jpg filter=lfs diff=lfs merge=lfs -text
ArtSource/AI/Approved/*.jpeg filter=lfs diff=lfs merge=lfs -text
ArtSource/AI/Approved/*.webp filter=lfs diff=lfs merge=lfs -text
Assets/_Game/Art/Generated/**/*.png filter=lfs diff=lfs merge=lfs -text
Assets/_Game/Art/Generated/**/*.jpg filter=lfs diff=lfs merge=lfs -text
Assets/_Game/Art/Generated/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
Assets/_Game/Art/Generated/**/*.webp filter=lfs diff=lfs merge=lfs -text
